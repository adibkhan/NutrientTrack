{
  "name": "nutrienttrack-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NutrientTrack — a local-first nutrition diary PWA.",
  "scripts": {
    "dev": "node scripts/copy-ocr-assets.mjs && vite",
    "build": "node scripts/copy-ocr-assets.mjs && tsc -b && vite build && node scripts/build-food-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:test": "node scripts/db-test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@zxing/browser": "^0.2.1",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "pg": "^8.23.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "wasm-feature-detect": "1.8.0"
  }
}
